import discord
from discord import app_commands
from discord.ext import commands
from datetime import datetime, timedelta
from zoneinfo import ZoneInfo

class ScheduleCog(commands.Cog):
    def __init__(self, bot):
        self.bot = bot

    # /schedule グループコマンドの定義
    schedule_group = app_commands.Group(
        name="schedule",
        description="メッセージの送信予約を行います",
        default_permissions=discord.Permissions(manage_messages=True)
    )

    @schedule_group.command(name="set", description="新しいメッセージの送信を予約します（最大1年以内）")
    @app_commands.describe(
        channel="送信先のチャンネル",
        message="送信するメッセージの内容",
        time="送信日時 (例: 2026-07-30 15:00)"
    )
    async def schedule_set(self, interaction: discord.Interaction, channel: discord.TextChannel, message: str, time: str):
        await interaction.response.defer(ephemeral=True)
        guild_id = str(interaction.guild.id)

        # 🟢 日本時間として正確にパース[span_0](start_span)[span_0](end_span)
        jst = ZoneInfo("Asia/Tokyo")
        try:
            normalized_time_str = time.replace(' ', 'T') + ":00"
            target_date = datetime.fromisoformat(normalized_time_str).replace(tzinfo=jst)
        except ValueError:
            return await interaction.editReply(
                content="❌ 日時の形式が正しくありません。「`YYYY-MM-DD HH:MM`」の形式で入力してください（例: `2026-07-30 15:00`）。[span_1](start_span)"[span_1](end_span)
            )

        now = datetime.now(jst)
        one_year_later = now + timedelta(days=365)

        if target_date <= now:
            return await interaction.editReply(content="❌ 過去の日時は指定できません。未来の時間を設定してください。")[span_2](start_span)[span_2](end_span)
        if target_date > one_year_later:
            return await interaction.editReply(content="❌ 予約できるのは現在から1年以内までです。")[span_3](start_span)[span_3](end_span)

        pool = self.bot.pool
        async with pool.acquire() as conn:
            await conn.execute(
                'INSERT INTO scheduled_messages (guild_id, channel_id, author_id, message_content, send_at) VALUES ($1, $2, $3, $4, $5)',
                guild_id, str(channel.id), str(interaction.user.id), message, target_date
            )

        formatted_time = target_date.strftime('%Y/%m/%d %H:%M')
        await interaction.editReply(content=f"✨ {channel.mention} へのメッセージ送信を **{formatted_time}** に予約しました！")[span_4](start_span)[span_4](end_span)

    @schedule_group.command(name="list", description="現在登録されている予約一覧を表示します")
    async def schedule_list(self, interaction: discord.Interaction):
        await interaction.response.defer(ephemeral=True)
        guild_id = str(interaction.guild.id)
        pool = self.bot.pool

        async with pool.acquire() as conn:
            rows = await conn.fetch(
                'SELECT id, channel_id, message_content, send_at FROM scheduled_messages WHERE guild_id = $1 ORDER BY send_at ASC',
                guild_id
            )

        if not rows:
            return await interaction.editReply(content="📭 このサーバーに登録されている予約メッセージはありません。")[span_5](start_span)[span_5](end_span)

        list_text = "📋 **現在の予約メッセージ一覧**\n"
        jst = ZoneInfo("Asia/Tokyo")
        for row in rows:
            send_at = row['send_at']
            if send_at.tzinfo is None:
                send_at = send_at.replace(tzinfo=ZoneInfo("UTC")).astimezone(jst)
            else:
                send_at = send_at.astimezone(jst)

            date_str = send_at.strftime('%Y/%m/%d %H:%M')
            content = row['message_content']
            preview = content[:20] + '...' if len(content) > 20 else content
            list_text += f"• **ID: {row['id']}** | チャンネル: <#{row['channel_id']}> | 予定: {date_str}\n  内容: `{preview}`\n"

        await interaction.editReply(content=list_text)[span_6](start_span)[span_6](end_span)

    @schedule_group.command(name="cancel", description="IDを指定して予約をキャンセルします")
    @app_commands.describe(id="キャンセルする予約のID (listコマンドで確認できます)")
    async def schedule_cancel(self, interaction: discord.Interaction, id: int):
        await interaction.response.defer(ephemeral=True)
        guild_id = str(interaction.guild.id)
        pool = self.bot.pool

        async with pool.acquire() as conn:
            # rows の削除結果を確認するため fetchrow を使用
            deleted = await conn.fetchrow(
                'DELETE FROM scheduled_messages WHERE id = $1 AND guild_id = $2 RETURNING id',
                id, guild_id
            )

        if not deleted:
            return await interaction.editReply(
                content=f"❌ ID `{id}` の予約が見つからないか、このサーバーの予約ではありません。[span_7](start_span)"[span_7](end_span)
            )

        await interaction.editReply(content=f"🗑️ ID `{id}` の予約をキャンセルしました。")[span_8](start_span)[span_8](end_span)

async def setup(bot):
    await bot.add_cog(ScheduleCog(bot))
